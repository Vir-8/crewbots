#!/bin/bash
# Releases this checkout to this Mac: runs the checks, builds the app and installs it, restarts the crew's daemon once
# no turn is running, relaunches the app (it keeps what you'd typed), and says what it did. How far it got is in
# ~/.crewbots/release.json, which the app reads when you update from it (Settings, Updates).
#
#   scripts/release              everything
#   scripts/release --daemon     checks, then the daemon only: for changes that don't touch the app
#
# Started from the app (by the daemon, CREWBOTS_RELEASE_FROM_APP set), it gets an update ready, then stops ("built"):
# the app installs it over itself, has the daemon restart once the crew is idle, and restarts. It does only what the
# update needs: the app is built when its code changed (CREWBOTS_RELEASE_APP=0 when it didn't: then only the daemon
# restarts, taking the checkout's code as it is). No tests: what's in the checkout passed them before it got there; the
# whole suite is a terminal release's. Only the daemon's dependencies are brought up to date, which a restart needs.
# CREWBOTS_RELEASE_EXPECTED is how long the last update like it took, for the app's progress bar.
# macOS lets an app replace itself, but not the daemon (a launchd service) touch an app it didn't make.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="/opt/homebrew/bin:$HOME/.cargo/bin:$PATH" # an Apple silicon node and cargo before any Intel ones

APP=/Applications/crewbots.app
SIGNING="crewbots local signing" # the certificate builds are signed with, when it's in your keychain (below)
BUILT=${CARGO_TARGET_DIR:-app/src-tauri/target}/release/bundle/macos/crewbots.app
daemon_only=false
[[ "${1:-}" == "--daemon" ]] && daemon_only=true
from_app=false
[[ -n "${CREWBOTS_RELEASE_FROM_APP:-}" ]] && from_app=true
build_app=true
{ $daemon_only || [[ "${CREWBOTS_RELEASE_APP:-1}" == "0" ]]; } && build_app=false
kind=$($build_app && echo app || echo daemon)

done_lines=()
started=$SECONDS
began=$(date +%s)
commit=$(git rev-parse --short=12 HEAD)
STATUS="$HOME/.crewbots/release.json"
current="Starting"
status() { # state, step[, the built app]: for the app, written whole so it never reads half of it
  mkdir -p "$(dirname "$STATUS")"
  printf '{"state": "%s", "step": "%s", "commit": "%s", "pid": %d, "started_at": %d, "at": %d, "bundle": "%s", "expected": %d, "kind": "%s"}\n' \
    "$1" "$2" "$commit" $$ "$began" "$(date +%s)" "${3:-}" "${CREWBOTS_RELEASE_EXPECTED:-0}" "$kind" >"$STATUS.tmp" &&
    mv "$STATUS.tmp" "$STATUS"
}
trap 'status failed "$current"' ERR
step() {
  printf '\n\033[1m== %s\033[0m\n' "$1"
  step_started=$SECONDS
  current="$1"
  status running "$1"
}
did() { done_lines+=("$1 ($((SECONDS - step_started))s)"); }

[[ -n "$(git status --porcelain)" ]] && echo "Note: the checkout has uncommitted changes; they go out too."

if $from_app; then
  step "Getting its dependencies"
  # The login service starts the daemon from the venv as it is: uv run brings it up to date first, and says if the
  # new code can't load.
  uv run python -c "import crewbots.api, crewbots.cli"
  did "The daemon's dependencies are up to date"
else
  step "Checks"
  uv run ruff check src tests
  uv run pytest -q -n auto
  (cd app && npx tsc --noEmit -p . && npm test --silent)
  did "Checks passed: ruff, pytest, tsc, the app's tests"
fi

if $build_app; then
  step "Building the app"
  # Made again by every build. macOS won't let one app overwrite files another left (they carry its provenance),
  # so a release from the app (run by the daemon) and one from a terminal would trip on each other's copies.
  rm -rf app/src-tauri/gen/schemas
  icons=()
  if $from_app; then
    # Its own copies of the icons: this process can't copy the checkout's (they carry the provenance of whatever
    # made them), but a copy it writes itself is its own.
    own="$CARGO_TARGET_DIR/icons"
    rm -rf "$own" && mkdir -p "$own"
    for icon in 32x32.png 128x128.png 128x128@2x.png icon.icns icon.ico; do cat "app/src-tauri/icons/$icon" >"$own/$icon"; done
    icons=(--config "{\"bundle\": {\"icon\": [\"$own/32x32.png\", \"$own/128x128.png\", \"$own/128x128@2x.png\", \"$own/icon.icns\", \"$own/icon.ico\"]}}")
  fi
  (cd app && npx tauri build --bundles app ${icons[@]+"${icons[@]}"})
  # macOS keeps what you allowed an app (the microphone, speech recognition, Documents) for the identity it's signed
  # with. A build signed only ad hoc is a new app to it every time, so it asks again after each update. With the
  # certificate below in your keychain, every build is signed by it and keeps them. To make it, once: Keychain Access,
  # Certificate Assistant > Create a Certificate, name it exactly this, Identity Type "Self Signed Root",
  # Certificate Type "Code Signing". The first build signed with it asks to use the key: Always Allow.
  if security find-certificate -c "$SIGNING" >/dev/null 2>&1; then
    codesign --force --deep --sign "$SIGNING" "$BUILT"
    did "Built the app at $commit, signed by $SIGNING"
  else
    did "Built the app at $commit (signed ad hoc: macOS will ask for its permissions again; see SIGNING in scripts/release)"
  fi
fi

if $from_app; then
  status built "Built" "$($build_app && echo "$(cd "$(dirname "$BUILT")" && pwd)/crewbots.app")"
  printf '\n\033[1mReady %s in %ss: %s.\033[0m\n' "$commit" "$((SECONDS - started))" \
    "$($build_app && echo "the app installs it and restarts" || echo "the daemon restarts once the crew is idle")"
  exit 0
fi

if ! $daemon_only; then
  step "Installing it"
  ditto "$BUILT" "$APP"
  did "Installed it in $APP"
fi

step "Restarting the daemon once the crew is idle"
before=$(python3 -c "import json,os; print(json.load(open(os.path.expanduser('~/.crewbots/crew/daemon.json')))['pid'])" 2>/dev/null || echo none)
uv run crewbots restart --when-idle
did "Restarted the daemon (pid $before before), from $commit"

if ! $daemon_only; then
  step "Relaunching the app"
  front=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || true)
  if pgrep -f "$APP/Contents/MacOS/crewbots" >/dev/null; then
    osascript -e 'quit app "crewbots"'
    for _ in $(seq 1 40); do pgrep -f "$APP/Contents/MacOS/crewbots" >/dev/null || break; sleep 0.25; done
  fi
  if pgrep -f "$APP/Contents/MacOS/crewbots" >/dev/null; then
    did "Left the app running: it didn't quit (a dialog open?), so relaunch it yourself"
  else
    # In front only if it was: a release shouldn't take you away from what you're doing. macOS can still be letting go
    # of the app that just quit, and refuses to open it meanwhile (error -600), so it's tried for a few seconds.
    opened=false
    for _ in 1 2 3 4 5 6; do
      if [[ "$front" == "crewbots" ]]; then flags=(-a); else flags=(-g -a); fi
      if open "${flags[@]}" "$APP" 2>/dev/null; then opened=true; break; fi
      sleep 1
    done
    if $opened; then
      did "Relaunched the app$([[ "$front" == "crewbots" ]] || echo " in the background"); what you'd typed is kept"
    else
      did "Couldn't relaunch the app (macOS kept refusing): open crewbots yourself"
    fi
  fi
fi

status done "Released"
printf '\n\033[1mReleased %s in %ss:\033[0m\n' "$commit" "$((SECONDS - started))"
printf '  - %s\n' "${done_lines[@]}"
